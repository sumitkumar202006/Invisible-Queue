{
  "name": "invisible-queue",
  "version": "1.0.0",
  "description": "Smart waiting-time prediction and crowd-management platform for essential public services",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm --prefix client run build",
    "dev": "node run-dev.js",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev:pred": "cd prediction && uvicorn app.main:app --reload --port 8000",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "pg": "^8.13.1",
    "zod": "^3.24.2"
  },
  "keywords": [
    "crowd-management",
    "queue-prediction",
    "public-services",
    "civic-tech"
  ],
  "author": "Invisible Queue Team",
  "license": "MIT"
}
